# Copy this file to .env and fill in your values

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB connection string
# Local:  mongodb://localhost:27017/recipeai
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/recipeai
MONGO_URI=mongodb://localhost:27017/recipeai

# Port for the Express server (optional, defaults to 5000)
PORT=5000
